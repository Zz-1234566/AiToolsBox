# 开发环境配置模板
# 复制本文件为 application-dev.yml，按本地实际值替换占位符后即可使用。
# application-dev.yml 已被 .gitignore 排除，不会提交到仓库。
spring:
  # MySQL
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/ai_toolbox?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: ${MYSQL_PASSWORD:your-mysql-password}

  # 邮件配置（QQ 邮箱 SMTP）
  mail:
    host: smtp.qq.com
    port: 465
    username: ${MAIL_USERNAME:your-email@qq.com}
    password: ${MAIL_PASSWORD:your-smtp-authorization-code}
    properties:
      mail.smtp.auth: true
      mail.smtp.ssl.enable: true
      mail.smtp.socketFactory.class: javax.net.ssl.SSLSocketFactory
      mail.smtp.socketFactory.fallback: false
      mail.smtp.ssl.protocols: TLSv1.2

  # Redis 配置
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 5000ms
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0

# JWT
# jwt.secret 必须通过环境变量 JWT_SECRET 设置（≥32 字节随机字符串）。
# 未设置时启动直接失败。
jwt:
  secret: ${JWT_SECRET}
  expiration: 604800000  # 7 days in milliseconds

# 腾讯云 COS：cos.enabled=true 启用 COS 存储（文件上传到 avatar/ 等前缀目录，公开读），
# 否则默认使用本地 uploads/ 目录存储。密钥仅本地开发配置，请勿提交到公共仓库。
cos:
  enabled: true
  secret-id: ${COS_SECRET_ID:your-cos-secret-id}
  secret-key: ${COS_SECRET_KEY:your-cos-secret-key}
  region: ap-guangzhou
  bucket: ${COS_BUCKET:your-cos-bucket-name}
  # 默认头像在桶内的 key 路径；URL 由 bucket + region 拼出
  default-avatar-key: ${DEFAULT_AVATAR_KEY:avatar/defaultAvatar.png}
  # 私有文件（file/{userId}/）签名 URL 有效期（秒）。到期后链接 403，前端需重新调接口。
  signed-url-ttl-seconds: ${COS_SIGNED_URL_TTL:300}


# 腾讯云 OCR（ai-ocr 工具用）。密钥默认复用 cos.*，留空即用 COS 密钥
# 不需要 OCR 时设 ocr.enabled=false
ocr:
  enabled: ${OCR_ENABLED:false}
  secret-id: ${OCR_SECRET_ID:}
  secret-key: ${OCR_SECRET_KEY:}
  region: ${OCR_REGION:}
  model: ${OCR_MODEL:GeneralAccurateOCR}

# 验证码配置
verify-code:
  expire-minutes: 5          # 验证码有效期（分钟）
  resend-seconds: 60         # 重发间隔（秒）
  length: 6                  # 验证码位数

# MiniMax 文本模型配置（办公类工具使用，OpenAI 兼容协议）
ai:
  minimax-text:
    # 官方 V2 文本接口（V2 明确标注为文本入口）
    api-url: https://api.minimaxi.com/v1/text/chatcompletion_v2
    api-key: ${AI_MINIMAX_TEXT_API_KEY:your-minimax-api-key}
    model: MiniMax-M2.7
    timeout-seconds: 60
  # MiniMax M3 多模态配置（AI 文件解读工具用）
  minimax:
    api-url: https://api.minimaxi.com/v1/chat/completions
    api-key: ${AI_MINIMAX_API_KEY:your-minimax-api-key}
    model: MiniMax-M3


# 录音转文本服务（MiniMax chatAudio + ffmpeg 转码）
# ffmpeg 可执行文件路径：空时走 PATH 自动查找
# Windows 推荐：D:/ffmpeg_extract/ffmpeg-master-latest-win64-gpl/bin/ffmpeg.exe
# Linux/Mac 一般可直接用系统 PATH 的 ffmpeg
asr:
  # 默认转写引擎：minimax | tencent。前端可选覆盖，不传则用此值。
  engine: ${ASR_ENGINE:minimax}
  ffmpeg-binary-path: ${ASR_FFMPEG_PATH:D:/ffmpeg_extract/ffmpeg-master-latest-win64-gpl/bin/ffmpeg.exe}
  sample-rate: 16000
  channels: 1
  # MiniMax 官方语音识别接口（/v1/chat/completions 不支持音频输入）
  api-url: ${ASR_API_URL:https://api.minimaxi.com/v1/speech_to_text}
  api-key: ${AI_MINIMAX_API_KEY:your-minimax-api-key}
  model: asr-1.0
  language: zh
  # ── 腾讯云语音识别通道（CreateRecTask 录音文件识别）──
  # secret-id / secret-key / region 留空时自动复用 cos.* 同一套凭证
  tencent:
    enabled: ${ASR_TENCENT_ENABLED:false}
    # AppId 为 ASR 专用，控制台「语音识别 → 账户信息」获取，形如 100047898545
    app-id: ${ASR_APP_ID:}
    secret-id: ${ASR_SECRET_ID:}
    secret-key: ${ASR_SECRET_KEY:}
    region: ${ASR_REGION:}
    engine-model-type: ${ASR_ENGINE_MODEL:16k_zh}
    channel-num: 1
    # 原始音频大小上限（字节）。腾讯云内联 base64 上限 5MB，反推约 3.7MB 留余量。
    max-audio-bytes: 3900000
    poll-interval-ms: 3000
    max-poll-times: 100
