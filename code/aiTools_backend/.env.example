# 本地开发环境变量模板
# 用法：复制本文件为 .env，按下面提示填入真实值即可被 spring-dotenv 自动加载
# .env 已在 .gitignore 排除，不会提交到仓库

# MySQL 密码
MYSQL_PASSWORD=

# 邮件配置（QQ 邮箱 SMTP）
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code

# JWT 签名密钥（建议 32+ 字节随机字符串）
JWT_SECRET=your-jwt-secret-key-please-change-in-production

# 腾讯云 COS 密钥
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key

# 腾讯云 OCR（密钥默认复用 COS，可单独覆盖；不设则用 COS 密钥）
# OCR_SECRET_ID=your-ocr-secret-id
# OCR_SECRET_KEY=your-ocr-secret-key
# OCR_REGION=ap-guangzhou
# OCR_MODEL=GeneralAccurateOCR

# 默认头像在 COS 桶内的 key 路径（可按需改成你桶里实际的默认头像文件名）
# 注意：必须是桶里真实存在的对象名，拼错（历史上误写成 defaultAvator.png，缺 r）
# 会让新注册用户的默认头像 URL 指向 404，前端 <image> 直接破图。
DEFAULT_AVATAR_KEY=avatar/defaultAvatar.png

# 腾讯云语音识别 ASR（录音转写工具的「腾讯云」引擎）
# 需先在控制台开通「语音识别」服务：https://console.cloud.tencent.com/asr
# AppId 为 ASR 专用，在「语音识别 → 账户信息」查看，形如 100047898545
ASR_TENCENT_ENABLED=false
ASR_APP_ID=
# 密钥默认复用 COS_*，一般无需单独设置；如需覆盖再取消注释
# ASR_SECRET_ID=
# ASR_SECRET_KEY=
# ASR_REGION=

# MiniMax M3 多模态（AI 文件解读工具用，OpenAI 兼容接口）
AI_MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
AI_MINIMAX_API_KEY=your-minimax-api-key
