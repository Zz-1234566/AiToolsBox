# 本地开发环境变量模板
# 用法：复制本文件为 .env，按下面提示填入真实值即可被 spring-dotenv 自动加载
# .env 已在 .gitignore 排除，不会提交到仓库

# MySQL 密码
MYSQL_PASSWORD=

# 邮件配置（QQ 邮箱 SMTP）
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code

# JWT 签名密钥（建议 32+ 字节随机字符串）
JWT_SECRET=your-jwt-secret-key-please-change-in-production

# 腾讯云 COS 密钥
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key

# 默认头像在 COS 桶内的 key 路径（可按需改成你桶里实际的默认头像文件名）
DEFAULT_AVATAR_KEY=avatar/defaultAvator.png

# DeepSeek（OpenAI 兼容）API Key
AI_DEEPSEEK_API_KEY=your-deepseek-api-key
